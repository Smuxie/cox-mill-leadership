{
  "name": "cox-mill-leadership",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/prepare-cms.mjs && node scripts/validate-content.mjs && astro build && node scripts/verify-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
