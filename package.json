    "configure": "node scripts/configure-cms.mjs"
  },
  "dependencies": { "astro": "7.4.5", "@tailwindcss/vite": "4.3.4", "tailwindcss": "4.3.4" },
  "devDependencies": { "@sveltia/cms": "0.258.1", "vite": "8.3.5" }
}
