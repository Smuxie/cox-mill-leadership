---
import Layout from '../layouts/Layout.astro';
import EventCollection from '../components/EventCollection.astro';
import Instagram from '../components/Instagram.astro';
import { site, announcements, links } from '../lib/content.mjs';
---
<Layout>
  <section class="hero shell"><div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span>{site.hero.eyebrow}</p><h1>{site.hero.headline}</h1><p class="hero-description">{site.hero.description}</p><div class="hero-actions"><a class="button dark" href={site.hero.primaryHref}>{site.hero.primaryLabel}<span aria-hidden="true">↗</span></a><a class="text-link" href={site.hero.secondaryHref}>{site.hero.secondaryLabel}<span aria-hidden="true">→</span></a></div><div class="hero-footnote"><span class="small-stars" aria-hidden="true">✳ ✳ ✳</span><span>Student-led. Community-minded.<br />Charger through and through.</span></div></div><div class="hero-visual">{site.hero.image ? <figure class="hero-photo"><img src={site.hero.image} alt={site.hero.imageAlt} width="900" height="1080" fetchpriority="high" /><figcaption>Cox Mill Leadership</figcaption></figure> : <div class="hero-poster" role="img" aria-label="Editorial leadership artwork reading Make your mark, with abstract teal and purple shapes"><div class="poster-top"><span>COX MILL<br />LEADERSHIP</span><span>↗</span></div><span class="poster-orbit orbit-one"></span><span class="poster-orbit orbit-two"></span><div class="poster-headline">MAKE<br /><span>YOUR</span><br />MARK.</div><div class="poster-bottom"><span>TOGETHER,<br />WE MOVE FORWARD.</span><span class="poster-star">✳</span></div></div>}<span class="visual-caption">{site.hero.image ? 'OUR COMMUNITY, IN FOCUS' : 'LEADERSHIP ARTWORK · ADD YOUR CLASS PHOTO'}</span><div class="visual-sticker">A little<br /><strong>CHARGER</strong><br />goes a long way. ↗</div></div></section>
  <div class="spirit-strip" aria-hidden="true"><div>STUDENT VOICE <span>✳</span> SCHOOL SPIRIT <span>✳</span> SHARED PURPOSE <span>✳</span> COX MILL LEADERSHIP <span>✳</span></div></div>
  <div class="shell announcement-stack" data-announcements>{announcements.filter(a=>a.status==='published'&&a.featured).map(item=><aside class="announcement" data-announcement data-expires={item.expiresAt}><span class="announcement-label">IN THE LOOP <span aria-hidden="true">↗</span></span><div><h2>{item.title}</h2><p>{item.body}</p></div>{item.url&&<a href={item.url} class="round-link" aria-label={`Read more: ${item.title}`}>↗</a>}</aside>)}<noscript><p class="small-note">Announcements may have expired. Check any dates before acting.</p></noscript></div>
  <section class="shell section-space"><div class="section-heading"><div><p class="eyebrow">SAVE THE DATE</p><h2>See you there.</h2><p>Find your next reason to show up.</p></div><a href="/events/" class="text-link">All upcoming events <span aria-hidden="true">↗</span></a></div><EventCollection mode="upcoming" limit={3} /></section>
  <section class="mission-section"><div class="shell mission-grid"><div><p class="eyebrow">MORE THAN A CLASS</p><h2>{site.mission.heading}</h2></div><div><p>{site.mission.description}</p><a class="text-link" href="/about/">Meet the mission <span aria-hidden="true">↗</span></a><div class="mission-values"><span>01 / SCHOOL SPIRIT</span><span>02 / SERVICE</span><span>03 / BELONGING</span></div></div></div></section>
  <section class="shell section-space"><div class="section-heading"><div><p class="eyebrow">THE REWIND</p><h2>Worth remembering.</h2><p>Good times. Shared effort. A growing story.</p></div><a href="/archive/" class="text-link">Explore the archive <span aria-hidden="true">↗</span></a></div><EventCollection mode="past" limit={3} /></section>
  <Instagram />
  <section class="shell section-space quick-links"><div><p class="eyebrow">A HEAD START</p><h2>Right where<br />you need to go.</h2></div><div>{links.links.map(link=><a href={link.url} target={link.url.startsWith('https:')?'_blank':undefined} rel="noopener noreferrer"><span><strong>{link.label}</strong><small>{link.description}</small></span><span aria-hidden="true">↗</span></a>)}</div></section>
</Layout>
