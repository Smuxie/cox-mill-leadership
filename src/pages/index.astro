---
import Layout from '../layouts/Layout.astro';
import EventCollection from '../components/EventCollection.astro';
import Instagram from '../components/Instagram.astro';
import { site, announcements, links } from '../lib/content.mjs';
---
<Layout>
  <section class:list={['hero shell', {'has-photo': Boolean(site.hero.image)}]}>
    <div class="hero-copy">
      <p class="eyebrow">{site.hero.eyebrow}</p>
      <h1>{site.hero.headline}</h1>
      <p class="hero-description">{site.hero.description}</p>
      <div class="hero-actions"><a class="button dark" href={site.hero.primaryHref}>{site.hero.primaryLabel}</a><a class="text-link" href={site.hero.secondaryHref}>{site.hero.secondaryLabel}</a></div>
    </div>
    {site.hero.image && <figure class="hero-photo"><img src={site.hero.image} alt={site.hero.imageAlt} width="900" height="600" fetchpriority="high" /></figure>}
  </section>
  <div class="shell announcement-stack" data-announcements>{announcements.filter(a=>a.status==='published'&&a.featured).map(item=><aside class="announcement" data-announcement data-expires={item.expiresAt}><span class="announcement-label">Announcement</span><div><h2>{item.title}</h2><p>{item.body}</p></div>{item.url&&<a href={item.url} class="text-link" aria-label={`Read more: ${item.title}`}>Details</a>}</aside>)}<noscript><p class="small-note">Announcements may have expired. Check any dates before acting.</p></noscript></div>
  <Instagram />
  <section class="shell section-space"><div class="section-heading"><h2>Upcoming events</h2><a href="/events/" class="text-link">View all upcoming events</a></div><EventCollection mode="upcoming" limit={3} /></section>
  <section class="shell section-space section-divider"><div class="section-heading"><h2>Past events</h2><a href="/archive/" class="text-link">View all past events</a></div><EventCollection mode="past" limit={3} /></section>
  <section class="shell section-space quick-links section-divider"><h2>School resources</h2><div>{links.links.map(link=><a href={link.url} target={link.url.startsWith('https:')?'_blank':undefined} rel="noopener noreferrer"><span><strong>{link.label}</strong><small>{link.description}</small></span><span aria-hidden="true">↗</span></a>)}</div></section>
</Layout>
