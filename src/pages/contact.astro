---
import Layout from '../layouts/Layout.astro';
import { site, links } from '../lib/content.mjs';
---
<Layout title="Get involved">
  <section class="page-intro shell"><a class="breadcrumb" href="/">Home</a><h1>Get involved</h1><p>{site.contact.intro}</p></section>
  <section class="shell contact-grid page-content">
    <div class="contact-card"><h2>School contact</h2><h3>{site.schoolName}</h3><address>{site.contact.address}</address><a href={`tel:${site.contact.phone.replace(/[^+0-9]/g,'')}`}>{site.contact.phone}</a>{site.contact.email&&<a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>}<a class="button dark" href={site.schoolUrl} target="_blank" rel="noopener noreferrer">School website ↗</a></div>
    <div class="contact-opportunities"><h2>Participation and sign-ups</h2><p class="prose-lines">{site.contact.opportunities}</p>{site.instagramUrl&&<a href={site.instagramUrl} class="text-link" target="_blank" rel="noopener noreferrer">Leadership Instagram ↗</a>}<div class="opportunity-links">{links.links.map(link=><a href={link.url} target={link.url.startsWith('https:')?'_blank':undefined} rel="noopener noreferrer"><strong>{link.label} ↗</strong><span>{link.description}</span></a>)}</div><p class="small-note">Use only school-approved forms. This website does not collect student submissions or contact details.</p></div>
  </section>
</Layout>
