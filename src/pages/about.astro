---
import Layout from '../layouts/Layout.astro';
import { site, team } from '../lib/content.mjs';
---
<Layout title="About leadership"><section class="page-intro shell"><a class="breadcrumb" href="/">Home /</a><p class="eyebrow">THE PEOPLE BEHIND THE MOMENTS</p><h1>{site.about.heading}</h1><p>{site.about.intro}</p></section><section class="shell about-layout page-content"><div class="about-art" aria-hidden="true"><span>COX MILL / LEADERSHIP</span><strong>WE<br />SHOW<br />UP.</strong><span>AND MAKE GOOD THINGS HAPPEN. ↗</span></div><div><p class="prose-lines large-copy">{site.about.body}</p><div class="about-principles"><article><span>01</span><h2>Build school spirit.</h2><p>Give students a reason to come together and celebrate being Chargers.</p></article><article><span>02</span><h2>Turn ideas into action.</h2><p>Plan thoughtfully, work as a team, and follow through on the details.</p></article><article><span>03</span><h2>Leave a positive mark.</h2><p>Serve our community and make space for more students to take part.</p></article></div></div></section>{team.members.length>0&&<section class="shell section-space"><p class="eyebrow">OUR PEOPLE</p><h2>Leadership, together.</h2><div class="team-grid">{team.members.map(person=><article>{person.image&&<img src={person.image} alt={person.imageAlt} loading="lazy" width="500" height="500" />}<h3>{person.name}</h3><p class="meta">{person.role}</p><p>{person.bio}</p></article>)}</div></section>}<section class="join-banner"><div class="shell"><p class="eyebrow">THERE’S ROOM FOR YOUR IDEAS</p><h2>You belong in<br />the next chapter.</h2><p>{site.about.participation}</p><a href="/contact/" class="button dark">Find your way in ↗</a></div></section></Layout>
