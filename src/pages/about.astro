---
import Layout from '../layouts/Layout.astro';
import InstagramPost from '../components/InstagramPost.astro';
import { site, team } from '../lib/content.mjs';
---
<Layout title="About leadership">
  <section class="page-intro shell"><a class="breadcrumb" href="/">Home</a><h1>{site.about.heading}</h1><p>{site.about.intro}</p></section>
  <section class="shell about-content page-content">
    {site.hero.image && <img class="class-photo" src={site.hero.image} alt={site.hero.imageAlt} width="1200" height="800" loading="lazy" />}
    <p class="prose-lines large-copy">{site.about.body}</p>
    {site.about.instagramUrl&&<section class="detail-section"><h2>Class activities</h2><div class="event-instagram"><InstagramPost url={site.about.instagramUrl} caption="Leadership at Trunk or Treat" /></div></section>}
    <section class="detail-section"><h2>Student involvement</h2><p>{site.about.participation}</p><a href="/contact/" class="button dark">Get involved</a></section>
  </section>
  {team.members.length>0&&<section class="shell section-space section-divider"><h2>Students and advisor</h2><div class="team-grid">{team.members.map(person=><article>{person.image&&<img src={person.image} alt={person.imageAlt} loading="lazy" width="500" height="500" />}<h3>{person.name}</h3><p class="meta">{person.role}</p><p>{person.bio}</p></article>)}</div></section>}
</Layout>
