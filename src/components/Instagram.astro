---
import { site, social } from '../lib/content.mjs';
const posts = [...social.posts].sort((a,b)=>Number(b.pinned)-Number(a.pinned));
---
<section class="social-section" aria-labelledby="social-title"><div class="shell social-layout"><div><span class="eyebrow light">FROM THE FEED</span><h2 id="social-title">The moments<br />between the moments.</h2><p>School spirit doesn’t stop at the bell. Follow the people making it happen.</p>{site.instagramUrl ? <a class="button teal" href={site.instagramUrl} target="_blank" rel="noopener noreferrer">Find us on Instagram <span aria-hidden="true">↗</span></a> : <p class="social-note">Our leadership Instagram link will appear here once it’s confirmed.</p>}<a class="subtle-link" href="/privacy/">About Instagram embeds & privacy</a></div><div class="social-posts">{posts.length ? posts.map((post,index)=><article class="instagram-card"><div class="social-card-top"><span>INSTAGRAM {post.pinned ? '· PINNED' : ''}</span><span aria-hidden="true">↗</span></div><p>{post.caption || 'A moment from Cox Mill Leadership.'}</p><div class="instagram-embed" data-instagram={post.url}><button class="button dark small" type="button" data-load-instagram>Load Instagram post</button><p class="embed-note">Loads content from Instagram and shares your IP address with Meta.</p></div><a href={post.url} target="_blank" rel="noopener noreferrer">View post on Instagram ↗</a></article>) : <div class="social-placeholder"><span class="instagram-glyph" aria-hidden="true">◎</span><span class="poster-kicker">SMALL MOMENTS.</span><strong>BIG<br />CHARGER<br />ENERGY.</strong><p>Selected posts will appear here.<br />Until then, stay connected at school.</p></div>}</div></div></section>
