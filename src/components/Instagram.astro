---
import { site, social } from '../lib/content.mjs';
import InstagramPost from './InstagramPost.astro';
const posts = social.posts.filter(post=>post.pinned);
---
<section class="social-section" aria-labelledby="social-title">
  <div class="shell">
    <div class="section-heading">
      <div><h2 id="social-title">Instagram</h2><p>Event announcements, photos, and updates from the leadership account.</p></div>
      {site.instagramUrl && <a class="text-link" href={site.instagramUrl} target="_blank" rel="noopener noreferrer">@coxmill_leadership ↗</a>}
    </div>
    {site.instagramUrl && <div class="instagram-feed"><InstagramPost url={site.instagramUrl} caption="Latest updates from Instagram" buttonLabel="Load Instagram feed" linkLabel="Open the leadership Instagram account" /></div>}
    {posts.length > 0 && <div class="social-posts">{posts.map(post=><InstagramPost url={post.url} caption={post.caption} pinned={post.pinned} />)}</div>}
    {!site.instagramUrl && posts.length === 0 && <p class="notice">The leadership Instagram link will be added when confirmed.</p>}
  </div>
</section>
