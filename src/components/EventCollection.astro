---
import { events } from '../lib/content.mjs';
import EventCard from './EventCard.astro';
const { mode = 'upcoming', limit = 0, controls = false } = Astro.props;
const categories = [...new Set(events.map(e=>e.category))].sort();
const years = [...new Set(events.map(e => {const [y,m]=e.date.split('-').map(Number);const a=m>=7?y:y-1;return `${a}–${a+1}`;}))].sort().reverse();
---
<section class="event-collection" data-events data-mode={mode} data-limit={limit} aria-label={mode === 'past' ? 'Past events' : 'Upcoming events'}>
  {controls && <div class="event-toolbar"><div class="filter-group"><label>Category<select data-filter="category"><option value="">All categories</option>{categories.map(c=><option value={c}>{c}</option>)}</select></label>{mode === 'past' && <label>School year<select data-filter="year"><option value="">All school years</option>{years.map(y=><option value={y}>{y}</option>)}</select></label>}<label>Sort by<select data-filter="order"><option value={mode==='past'?'desc':'asc'}>{mode==='past'?'Newest first':'Soonest first'}</option><option value={mode==='past'?'asc':'desc'}>{mode==='past'?'Oldest first':'Latest first'}</option></select></label></div>{mode==='upcoming' && <div class="view-switch" aria-label="Event view"><button type="button" data-view="list" aria-pressed="true">List</button><button type="button" data-view="calendar" aria-pressed="false">Calendar</button></div>}</div>}
  <p class="event-count sr-only" role="status" aria-live="polite"></p>
  <div class="event-grid" data-event-list>{events.map(event=><EventCard event={event} />)}</div>
  <div class="empty-state" data-empty hidden><span class="empty-symbol" aria-hidden="true">↗</span><div><h3>{mode === 'past' ? 'More memories are on the way.' : 'The next good thing is on its way.'}</h3><p>{mode === 'past' ? 'No past events match these filters. Try another category or school year.' : 'No upcoming events match this view. Check back for new plans, or explore what we’ve been up to.'}</p><a class="text-link" href={mode === 'past' ? '/events/' : '/archive/'}>{mode === 'past' ? 'Explore upcoming events' : 'Visit the event archive'} <span aria-hidden="true">↗</span></a></div></div>
  {controls && mode==='upcoming' && <div class="calendar" data-calendar hidden><div class="calendar-nav"><button type="button" data-month="-1" aria-label="Previous month">←</button><h3 data-month-label aria-live="polite"></h3><button type="button" data-month="1" aria-label="Next month">→</button></div><p class="calendar-zone">Calendar dates and times are in America/New_York.</p><div class="calendar-weekdays" aria-hidden="true">{['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map(d=><span>{d}</span>)}</div><div class="calendar-days" data-days></div></div>}
  <noscript><p class="notice">JavaScript is off. All published events are listed above with their dates. Date-based views, filters, and the calendar need JavaScript.</p></noscript>
</section>
