---
import { site, links } from '../lib/content.mjs';
import '../styles/global.css';
const { title = '', description = site.description } = Astro.props;
const pathname = Astro.url.pathname;
const nav = [{href:'/events/',label:'Upcoming events'},{href:'/archive/',label:'The archive'},{href:'/about/',label:'About us'}];
const theme = `--ink:${site.theme.navy};--teal:${site.theme.accent};--purple:${site.theme.purple};--paper:${site.theme.background};`;
---
<!doctype html>
<html lang="en" style={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={site.theme.navy} />
    <meta property="og:title" content={`${title ? `${title} | ` : ''}Cox Mill Leadership`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title ? `${title} | ` : ''}Cox Mill Leadership</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="Cox Mill Leadership home"><span class="brand-mark" aria-hidden="true">CM<span>↗</span></span><span><strong>COX MILL</strong><small>{site.programName.toUpperCase()}</small></span></a>
        <button class="menu-toggle" aria-controls="main-nav" aria-expanded="false"><span>Menu</span><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18" fill="none" stroke="currentColor" stroke-width="2" /></svg></button>
        <nav id="main-nav" aria-label="Main navigation">
          {nav.map(item => <a href={item.href} aria-current={pathname.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>)}
          <a class="button small dark" href="/contact/" aria-current={pathname.startsWith('/contact/') ? 'page' : undefined}>Get involved <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-top">
        <div><a href="/" class="footer-wordmark">COX MILL<span>LEADERSHIP ↗</span></a><p>{site.tagline}<br />{site.footerMessage}</p><span class="location">CONCORD, NORTH CAROLINA</span></div>
        <div class="footer-links"><strong>Find your way</strong><a href="/events/">Upcoming events</a><a href="/archive/">Past events</a><a href="/about/">About leadership</a><a href="/contact/">Get involved</a></div>
        <div class="footer-links"><strong>Stay connected</strong>{site.instagramUrl && <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer">Leadership on Instagram ↗</a>}<a href={site.schoolUrl} target="_blank" rel="noopener noreferrer">Official school website ↗</a>{links.links.slice(1,2).map(link=><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}<a href="/admin/">Student editor login</a></div>
      </div>
      <div class="shell footer-bottom"><span>© {new Date().getFullYear()} {site.schoolName} · Leadership</span><a href="/privacy/">Privacy & accessibility</a><span>Built on student initiative.</span></div>
    </footer>
    <script>
      import '../scripts/site.mjs';
    </script>
  </body>
</html>
